# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API в Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Project Settings → API → service_role key (СЕКРЕТНЫЙ — только server-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App URL ────────────────────────────────────────────────────────────────────
# Для локальной разработки: http://localhost:3000
# Для production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Wazzup OAuth (необязательно — только для интеграции WhatsApp) ─────────────
# Партнёрский кабинет: https://cabinet.wazzup24.com
WAZZUP_CLIENT_ID=
WAZZUP_PARTNER_EMAIL=
WAZZUP_PARTNER_PASSWORD=

# ── Telegram Bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Webhook authentication — только hex-секреты: openssl rand -hex 32
# (Telegram допускает в secret_token лишь A-Za-z0-9_-, поэтому base64 не подойдёт).
# TELEGRAM_WEBHOOK_SECRET — secret_token, сверяется с X-Telegram-Bot-Api-Secret-Token.
#   Пусто = webhook работает FAIL-OPEN (принимает всё) и пишет error-лог на каждой инвокации.
# TELEGRAM_SETUP_SECRET — сверяется с X-Setup-Secret в POST /api/telegram/setup.
#   Пусто = setup-роут отвечает 503 (fail-closed).
# Порядок: env в Vercel (Prod+Preview) → redeploy → curl -X POST -H "X-Setup-Secret: …" <prod>/api/telegram/setup
#
# URL webhook'а строится ТОЛЬКО из NEXT_PUBLIC_APP_URL (см. блок App URL выше):
#   <NEXT_PUBLIC_APP_URL>/api/telegram/webhook
# Host входящего запроса и отдельная переменная TELEGRAM_WEBHOOK_URL не используются
# (защита от Host-header injection и регистрации на preview-алиасе).
# Если NEXT_PUBLIC_APP_URL пуст/невалиден → setup-роут отвечает 500 (app_url_not_set/app_url_invalid).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SETUP_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=AD Pulse <noreply@yourdomain.com>
