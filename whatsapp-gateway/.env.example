# ─── AD Pulse WhatsApp Gateway ────────────────────────────────────────────────
# Скопируйте в .env и заполните. Внутри Docker переменные передаются через
# docker-compose / docker run -e, файл .env нужен только для локального запуска.

# Порт HTTP-сервера шлюза
PORT=8080

# Секрет для внутренних вызовов шлюза из приложения AD Pulse.
# Любой длинный случайный строковый токен. Приложение шлёт его как
# Authorization: Bearer <GATEWAY_TOKEN>. Сгенерировать:
#   openssl rand -hex 32
GATEWAY_TOKEN=

# Куда шлюз отправляет входящие сообщения (вебхук AD Pulse).
# Это тот же токен, что в URL /api/whatsapp/webhook/<token>.
APP_URL=https://pulse.altaidynamics.kz
APP_WEBHOOK_PATH=/api/whatsapp/webhook
APP_WEBHOOK_TOKEN=

# Каталог для хранения сессий WhatsApp, кэша чатов и медиа.
# В Docker монтируется как volume — иначе после рестарта клиенты
# будут вынуждены сканировать QR заново.
DATA_DIR=./data

# Уровень логов: trace | debug | info | warn | error
LOG_LEVEL=info

# Скачивать ли медиа (фото накладных, голосовые) с WhatsApp.
# Отключите, если не нужен разбор фото/голоса — экономит диск.
MEDIA_ENABLED=true

# Сколько дней хранить скачанные медиафайлы (0 = не удалять)
MEDIA_RETENTION_DAYS=30

# Максимальный размер одного медиафайла в байтах (по умолчанию 20 МБ)
MEDIA_MAX_BYTES=20971520

# Подтягивать ли историю чатов при первом подключении.
# Нужно для списка чатов с названиями. Для аккаунтов с огромной
# историей первый синк может идти несколько минут.
SYNC_HISTORY=true
