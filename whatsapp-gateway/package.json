{
  "name": "adpulse-whatsapp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted WhatsApp gateway for AD Pulse (Baileys).",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "baileys": "6.7.24",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.2"
  }
}
